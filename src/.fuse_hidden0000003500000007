<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>DeskPal Settings</title>
  <link rel="stylesheet" href="settings.css">
</head>
<body>
  <nav id="tabs" role="tablist">
    <div class="brand"><span class="dot"></span>DeskPal</div>
    <button role="tab" data-tab="pet" class="on">Pet</button>
    <button role="tab" data-tab="character">Character</button>
    <button role="tab" data-tab="focus">Focus</button>
    <button role="tab" data-tab="reminders">Reminders</button>
    <button role="tab" data-tab="notes">Notes</button>
    <button role="tab" data-tab="wellbeing">Wellbeing</button>
    <button role="tab" data-tab="general">General</button>
    <div class="saved" id="saved" aria-live="polite"></div>
  </nav>

  <main>
    <!-- PET -->
    <section data-panel="pet" class="on">
      <h1>Pet</h1>
      <label class="row"><span>Your name<small>Used when you say hi.</small></span>
        <input id="userName" type="text" maxlength="40" placeholder="e.g. Shyam"></label>
      <label class="row"><span>Size</span>
        <span class="range"><input id="scale" type="range" min="0.5" max="2" step="0.05"><output id="scaleOut"></output></span></label>
      <label class="row"><span>Speed</span>
        <span class="range"><input id="speed" type="range" min="0.5" max="2" step="0.05"><output id="speedOut"></output></span></label>
      <label class="row check"><input id="wander" type="checkbox"><span>Wander along the Dock</span></label>
      <label class="row check"><input id="sleepy" type="checkbox"><span>Doze off when left alone (5 min)</span></label>
      <label class="row check"><input id="follow" type="checkbox"><span>Eyes follow the mouse<small>Needs a <code>pupil</code> part in the SVG.</small></span></label>
      <label class="row"><span>Weather city<small>For “weather?” — or ask “weather in Mumbai?”</small></span>
        <input id="city" type="text" maxlength="80" placeholder="e.g. Chennai"></label>
    </section>

    <!-- CHARACTER -->
    <section data-panel="character">
      <h1>Character</h1>
      <p class="lead">Use any SVG as your pet. It walks, breathes, hops and sleeps as-is.
        Name groups in your SVG to unlock extra moves — see <code>docs/CHARACTER_SVG.md</code>.</p>
      <div class="charbox">
        <div id="charPreview"></div>
        <div>
          <p class="found" id="charParts"></p>
          <p class="err" id="charErr" hidden></p>
          <div class="btns">
            <label class="btn primary">Choose SVG…<input id="charFile" type="file" accept=".svg,image/svg+xml" hidden></label>
            <button class="btn" id="charReset" type="button">Use default</button>
          </div>
        </div>
      </div>
    </section>

    <!-- FOCUS -->
    <section data-panel="focus">
      <h1>Focus</h1>
      <label class="row"><span>Session length<small>Minutes. Also: type /timer 50 in the chat.</small></span>
        <input id="sessionMinutes" type="number" min="1" max="600"></label>
      <label class="row check"><input id="chimeOn" type="checkbox"><span>Chime when a session ends</span></label>
      <div class="row"><span id="sessionState">No session running.</span>
        <span class="btns"><button class="btn primary" id="sessionStart" type="button">Start</button>
        <button class="btn" id="sessionStop" type="button">Stop</button></span></div>
    </section>

    <!-- REMINDERS -->
    <section data-panel="reminders">
      <h1>Reminders</h1>
      <p class="lead">Or type <code>/remind call Kavi at 5pm</code> in the chat.</p>
      <div id="remList" class="list"></div>
      <button class="btn" id="remAdd" type="button">+ Add reminder</button>
    </section>

    <!-- NOTES -->
    <section data-panel="notes">
      <h1>Notes</h1>
      <p class="lead">Anything you type in the chat that isn’t a question or a /command lands here, newest first.</p>
      <div id="noteList" class="list"></div>
    </section>

    <!-- WELLBEING -->
    <section data-panel="wellbeing">
      <h1>Wellbeing</h1>
      <label class="row check"><input id="waterOn" type="checkbox"><span>Water reminders</span></label>
      <label class="row"><span>Every<small>Minutes (paused during focus sessions).</small></span>
        <input id="waterEvery" type="number" min="5" max="480"></label>
      <label class="row check"><input id="bedOn" type="checkbox"><span>Bedtime — the pet says goodnight and sleeps</span></label>
      <div class="row"><span>From / to</span>
        <span class="btns"><input id="bedFrom" type="time"><input id="bedTo" type="time"></span></div>
    </section>

    <!-- GENERAL -->
    <section data-panel="general">
      <h1>General</h1>
      <label class="row check"><input id="autostart" type="checkbox"><span>Open at login</span></label>
      <div class="row"><span>Pet</span><span class="btns">
        <button class="btn" id="showPet" type="button">Show</button>
        <button class="btn" id="hidePet" type="button">Hide</button></span></div>
      <div class="row"><span>Version</span><span id="version" class="muted"></span></div>
      <div class="row"><span>Data</span><span class="muted">Settings and notes stay on this Mac. Only “weather?” uses the internet (Open-Meteo).</span></div>
      <div class="row"><span></span><button class="btn danger" id="quit" type="button">Quit DeskPal</button></div>
    </section>
  </main>

  <script type="module" src="settings.js"></script>
</body>
</html>
